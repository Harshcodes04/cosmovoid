# Backend
# Copy these values to backend/.env for local backend development.
NODE_ENV=development
PORT=5500
FRONTEND_PORT=5173
MONGO_URI=mongodb://127.0.0.1:27017/cosmovoid
JWT_SECRET=replace_with_a_long_random_secret
NASA_API_KEY=DEMO_KEY
ASTRONOMY_API_ID=your_astronomy_api_id
ASTRONOMY_API_SECRET=your_astronomy_api_secret

# Frontend
# Copy this value to frontend/.env for local frontend development.
VITE_API_BASE_URL=http://localhost:5500/api
